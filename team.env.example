# CẤU HÌNH DÙNG NHANH CHO THÀNH VIÊN — CHỈ MÔI TRƯỜNG LOCAL
#
# File này chứa thông tin phát triển đã công khai trong repository, không phải secret.
# Chỉ dùng khi Gateway còn bind 127.0.0.1 như compose.yaml hiện tại.
# Tuyệt đối không dùng nguyên các giá trị này trên VPS, domain public hoặc bản demo chung.
#
# Cách dùng trên máy mới:
#   cp team.env.example .env
#   make up

# Cổng duy nhất được công khai ra máy phát triển.
GATEWAY_PORT=8080

# URL người dùng mở trên máy local.
PUBLIC_ORIGIN=http://127.0.0.1:8080

# Hậu tố URL dành cho Web Service động trên máy local.
SERVICE_BASE_DOMAIN=localhost

# Chỉ repository công khai thuộc các owner thành viên mới được build.
TRUSTED_GITHUB_OWNERS=VietDSK6,mait21606-coder,thaole-udud24,THM-B24DCCC206

# Phiên bản mặc định của hai ứng dụng mẫu.
APP_A_VERSION=v1.0.0
APP_B_VERSION=v1.0.0

# Tài khoản Dashboard local.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=MiniPaaS_Local_Admin_2026

# Tài khoản Grafana local.
GRAFANA_ADMIN_PASSWORD=MiniPaaS_Local_Grafana_2026

# Phiên đăng nhập local dùng HTTP, không bật Secure cookie.
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_SECURE=false

# Chuỗi phát triển dùng cho giao tiếp Control API → Runner.
# Đây là giá trị công khai dành riêng cho loopback local, không phải secret production.
RUNNER_SHARED_SECRET=MiniPaaS_Local_Runner_Shared_Secret_2026

# Khóa phát triển để mã hóa biến môi trường trong SQLite local.
# Không dùng khóa này cho VPS hoặc dữ liệu cần bảo vệ thật.
ENVIRONMENT_ENCRYPTION_KEY=MiniPaaS_Local_Environment_Encryption_Key_2026
