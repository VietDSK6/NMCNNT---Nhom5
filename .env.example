# Cổng duy nhất được công khai ra máy phát triển.
GATEWAY_PORT=8080

# URL người dùng dùng để mở Gateway. Khi đưa lên VPS, thay bằng domain HTTPS.
PUBLIC_ORIGIN=http://127.0.0.1:8080

# Domain gốc dùng để cấp URL riêng cho Web Service, ví dụ demo.ai2p.id.vn.
SERVICE_BASE_DOMAIN=localhost

# Chỉ repository GitHub công khai thuộc các owner này mới được build.
# Phân tách nhiều owner bằng dấu phẩy.
TRUSTED_GITHUB_OWNERS=VietDSK6

# Phiên bản được đóng vào ảnh Docker và hiển thị trên giao diện.
APP_A_VERSION=v1.0.0
APP_B_VERSION=v1.0.0

# Tài khoản quản trị P0.2. Phải thay giá trị mẫu trước khi khởi động.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_use_at_least_12_chars

# Grafana có lần đăng nhập riêng, không dùng chung cookie Dashboard.
# Nên đặt mật khẩu khác ADMIN_PASSWORD; nếu bỏ biến này, Compose dùng ADMIN_PASSWORD.
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_use_a_different_12_char_password

# Phiên đăng nhập tồn tại 8 giờ. Chỉ đặt true sau khi Gateway dùng HTTPS.
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_SECURE=false

# Bí mật dùng riêng cho Control API gọi Deployment Runner trong mạng nội bộ.
# Tối thiểu 24 ký tự và phải khác ADMIN_PASSWORD.
RUNNER_SHARED_SECRET=CHANGE_ME_use_at_least_24_chars

# Khóa riêng để mã hóa giá trị biến môi trường ứng dụng trong SQLite.
# Nên đặt ít nhất 32 ký tự. Nếu bỏ trống, môi trường phát triển tạm dùng RUNNER_SHARED_SECRET.
ENVIRONMENT_ENCRYPTION_KEY=CHANGE_ME_use_a_different_32_char_encryption_key
